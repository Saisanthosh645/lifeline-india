# ── Lifeline India API — Environment Configuration ────────────────────────
# This is the single source of truth. Copy to .env for local development.
# For production (Render), set these via Render dashboard env vars.

# Database
DATABASE_URL=postgresql+asyncpg://lifeline:lifeline@localhost:5432/lifeline

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Environment
ENVIRONMENT=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@lifelineindia.in
SMTP_USE_TLS=true